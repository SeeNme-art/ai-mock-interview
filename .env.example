# 复制为 .env 后填写。.env 不进版本库。
# 字段名与 src/app/config.py 中的 Settings 一一对应，大小写不敏感。

# ---------- 基础 ----------
ENV=dev
LOG_LEVEL=INFO

# ---------- 模型（后续实验验证；P0 不发模型请求） ----------
DEEPSEEK_API_KEY=
LLM_MODEL_MAIN=deepseek-chat
LLM_MODEL_FAST=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1

# ---------- 可观测 ----------
OBSERVE_UI=true
# P0 只支持元数据；设置 true 会拒绝启动，不记录正文预览或原始异常消息。
OBSERVE_STORE_IO=false

# ---------- 预算 ----------
# 尚未实测，P0 不调用模型；真实调用前须另行确定预算，不能据此认为已实现限额。
# 首版没有整场墙钟强制结束配置。
